# =============================================================================
# 量化 Hub-and-Spoke 多智能体 — 统一环境与模型（复制为 .env 后按需修改）
# 路径：deploy/quant-hub-spoke/.env
# =============================================================================
# 用法：
# 1. 复制本文件为同目录下的 .env（勿提交 .env 到 Git）。
# 2. 将下方 MODEL_* 与 ~/.openclaw/openclaw.json 中各 agent 的 model.primary 保持一致。
# 3. 模型引用名须与 openclaw.json 的 models.providers 中已注册 id 一致（可用 openclaw models list 核对）。
# =============================================================================
#
# 当前推荐分工（与仓库内 openclaw 片段及本机配置对齐时参考）：
# | 角色            | agent id           | 建议 primary                      |
# |-----------------|--------------------|-----------------------------------|
# | Hub             | seth               | deepseek-api/deepseek-v4-pro      |
# | Research        | quant-research     | deepseek-api/deepseek-v4-flash    |
# | Engineering     | quant-engineering  | deepseek-api/deepseek-v4-pro      |
# | QA              | quant-qa           | cursor-local/auto                   |
# | Doc writer      | quant-doc-writer   | deepseek-api/deepseek-v4-flash    |
# =============================================================================

# --- Hub（Seth）---
MODEL_HUB_SETH_PRIMARY=deepseek-api/deepseek-v4-pro
MODEL_HUB_SETH_FALLBACK=

# --- Research ---
MODEL_RESEARCH_PRIMARY=deepseek-api/deepseek-v4-flash
MODEL_RESEARCH_FALLBACK=

# --- Engineering ---
MODEL_ENGINEERING_PRIMARY=deepseek-api/deepseek-v4-pro
MODEL_ENGINEERING_FALLBACK=

# --- QA ---
MODEL_QA_PRIMARY=ollama/qwen3:8b
MODEL_QA_FALLBACK=

# --- Doc writer ---
MODEL_DOC_WRITER_PRIMARY=deepseek-api/deepseek-v4-flash
MODEL_DOC_WRITER_FALLBACK=

# --- 可选：容器内调用 Ollama / API ---
OLLAMA_BASE_URL=http://host.docker.internal:11434
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# --- 可选：Gateway / Cove ---
# OPENCLAW_GATEWAY_WS=ws://127.0.0.1:18789
# OPENCLAW_GATEWAY_TOKEN=

PIP_INDEX_URL=
PYTHONUNBUFFERED=1
