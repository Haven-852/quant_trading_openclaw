# =============================================================================
# 量化 Hub-and-Spoke 多智能体 — 统一环境与模型（复制为 .env 后按需修改）
# 路径：deploy/quant-hub-spoke/.env
# =============================================================================
# 用法：
# 1. 复制本文件为同目录下的 .env（勿提交 .env 到 Git）。
# 2. 将下方 MODEL_* 的值填入 ~/.openclaw/openclaw.json 中对应 agent 的 model.primary。
# 3. Docker 容器内若需调用 Ollama / API，可复用 OLLAMA_* / OPENAI_* 等变量。
# =============================================================================

# --- Hub 中心智能体（Seth）：任务拆解、分发、汇总；唯一对外指令入口 ---
MODEL_HUB_SETH_PRIMARY=ollama/qwen3:8b
MODEL_HUB_SETH_FALLBACK=

# --- 研究员（Research）：调研、情报、文献与数据源评估 ---
MODEL_RESEARCH_PRIMARY=ollama/qwen3:8b
MODEL_RESEARCH_FALLBACK=

# --- 工程组（Engineering）：配置、前后端与策略代码实现（由 Hub 拆任务后下发）---
MODEL_ENGINEERING_PRIMARY=ollama/qwen3:8b
MODEL_ENGINEERING_FALLBACK=

# --- 测试组（QA）：单测、回测脚本、冒烟与验收 ---
MODEL_QA_PRIMARY=ollama/qwen3:8b
MODEL_QA_FALLBACK=

# --- 可选：容器内或本机工具链调用 LLM / 数据 API（与 openclaw.json 中 providers 对齐）---
OLLAMA_BASE_URL=http://host.docker.internal:11434
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# --- 可选：与 Gateway / Cove 对齐（仅文档用途，OpenClaw 主配置仍在用户目录）---
# OPENCLAW_GATEWAY_WS=ws://127.0.0.1:18789
# OPENCLAW_GATEWAY_TOKEN=

# --- Python / pip（工程与 QA 容器内可选）---
PIP_INDEX_URL=
PYTHONUNBUFFERED=1
